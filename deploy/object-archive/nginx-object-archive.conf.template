# Install as a separate nginx server block on the public edge host after the
# http-context nginx-carddeck-catalog.http.conf.template has defined the shared
# request-rate zones. Render the two @...@ placeholders before installation.

server {
    listen 80;
    listen [::]:80;
    server_name ~^(?<archive_bucket>[a-z0-9][a-z0-9-]*)\.@OBJECT_ARCHIVE_DOMAIN@$;

    client_max_body_size 1m;

    location / {
        limit_except GET HEAD { deny all; }
        limit_req zone=carddeck_archive_rl burst=30 nodelay;
        limit_req_status 429;
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ~^(?<archive_bucket>[a-z0-9][a-z0-9-]*)\.@OBJECT_ARCHIVE_DOMAIN@$;

    # Supply a wildcard certificate for *.@OBJECT_ARCHIVE_DOMAIN@ here.
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;

    # Migration rollback copies live under rollback/ in these public buckets;
    # they are for operators (S3 API over the Tailnet), never for the public.
    location ^~ /rollback/ {
        return 404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        limit_req zone=carddeck_archive_rl burst=30 nodelay;
        limit_req_status 429;

        # Keep the original Host header: Garage derives the bucket from it.
        proxy_pass http://@GARAGE_WEB_UPSTREAM@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
