BAD_DECISIONS_LOG_LEVEL=INFO
BAD_DECISIONS_ROOT_PATH=/bad-decisions
# deploy.sh sets this to a private persistent directory under APP_ROOT.
# BAD_DECISIONS_PEER_PRESSURE_DIR=/opt/bad-decisions/peer-pressure
# BAD_DECISIONS_PEER_PRESSURE_MAX_ROOMS=200
# BAD_DECISIONS_PEER_PRESSURE_MAX_PLAYERS=12
# BAD_DECISIONS_PEER_PRESSURE_MIN_FREE_MB=256
# BAD_DECISIONS_RATE_LIMIT_PER_MINUTE=30
# BAD_DECISIONS_CORS_ORIGINS=https://example.com
# Optional: existing directory must be writable by the service user. Disabled without this setting.
# BAD_DECISIONS_CONSEQUENCES_DB=/var/lib/bad-decisions/consequences.sqlite3
# BAD_DECISIONS_CONSEQUENCES_FEEDBACK=1
# BAD_DECISIONS_CONSEQUENCES_RETENTION_DAYS=90
# Optional: the tailnet-only management page (docs/MANAGEMENT_AUTH.md). Use
# `sudo ./deploy.sh install-management`, which writes these for you.
# BAD_DECISIONS_MANAGEMENT_DB=/opt/bad-decisions/management/management.sqlite3
# BAD_DECISIONS_MANAGEMENT_PUBLIC_ORIGIN=https://example.com
# BAD_DECISIONS_MANAGEMENT_ATTEST_URL=https://host.tailnet.ts.net:8443
# BAD_DECISIONS_MANAGEMENT_TAGS=tag:mgmt
