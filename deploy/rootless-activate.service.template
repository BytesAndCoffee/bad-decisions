[Unit]
Description=Activate a staged Bad Decisions release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Oneshot units never time out by default; a hung pip must not wedge activation.
TimeoutStartSec=20min
UMask=0027
ExecStart=@PYTHON@ -I /usr/libexec/@APP_NAME@-activate --app-root @APP_ROOT@ --service-name @SERVICE_NAME@ --service-user @SERVICE_USER@ --deploy-group @DEPLOY_GROUP@ --bind-host @BIND_HOST@ --port @PORT@ --python @PYTHON@
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
